# Copy to .env for local development.
APP_ENV=development
LOG_LEVEL=debug

API_ADDR=:8080
DATABASE_URL=postgres://adwise:adwise@localhost:5432/adwise?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Base URL of the web app, used to build invitation links.
WEB_BASE_URL=http://localhost:3000

SESSION_TTL=720h
# Set to true when served over HTTPS.
COOKIE_SECURE=false

# --- Provider integrations (internal/integrations) ---
# AES-256-GCM key for provider tokens: base64 of 32 random bytes, optionally
# "id:<b64>,oldid:<b64>" to rotate (first key encrypts, all decrypt).
# Generate a real one with: openssl rand -base64 32
# The value below is a PUBLIC development key; it is refused outside development.
TOKEN_ENCRYPTION_KEY=dev1:ZGV2LW9ubHktYWR3aXNlLXRva2VuLWtleS0zMmJ5dGU=
# Browser-facing API base used for OAuth redirect URIs
# ({API_BASE_URL}/v1/integrations/{meta|google}/callback). Defaults to
# ${WEB_BASE_URL}/api, i.e. through the Next.js proxy.
API_BASE_URL=http://localhost:3000/api

# Meta app (developers.facebook.com). Leave empty to disable Meta (503 provider_not_configured).
META_APP_ID=
META_APP_SECRET=
#META_API_VERSION=v26.0
#META_CONVERSION_ACTION_TYPE=purchase
# Instant leads: any random string; enter the same value as the "Verify token"
# of the Page webhook (field leadgen) in the Meta App Dashboard, with callback
# URL <API public URL>/v1/webhooks/meta. Unset disables the webhook handshake.
#META_WEBHOOK_VERIFY_TOKEN=

# Google Cloud OAuth client (web application) + Google Ads developer token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DEVELOPER_TOKEN=
# Optional default manager (MCC) account used as login-customer-id.
#GOOGLE_LOGIN_CUSTOMER_ID=
#GOOGLE_ADS_API_VERSION=v25

# --- Email (internal/platform/mailer) ---
# Emails (alerts, etc.) are sent by the worker. With SMTP_HOST empty the "log"
# driver is used: nothing is sent, the worker logs recipient + subject only.
#MAIL_DRIVER=smtp            # smtp | log (default: smtp when SMTP_HOST is set)
MAIL_FROM=Adwise <alerts@localhost>
#
#Local: `make up` starts Mailpit; every email shows up at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_TLS=none
#
# SMTP_TLS: implicit (port 465) | starttls (port 587, default) | none (local only).
# Credentials are never sent unencrypted except to localhost.
# Examples (from address must be verified with the provider):
#   Gmail / Google Workspace (app password):
#     SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_TLS=starttls
#     SMTP_USERNAME=you@yourdomain.com SMTP_PASSWORD=<16-char app password>
#   Amazon SES (SMTP credentials, not IAM keys):
#     SMTP_HOST=email-smtp.us-east-1.amazonaws.com SMTP_PORT=587 SMTP_TLS=starttls
#     SMTP_USERNAME=<ses smtp user> SMTP_PASSWORD=<ses smtp password>
#   Brevo / Mailgun / Postmark / Resend style providers:
#     SMTP_HOST=smtp-relay.brevo.com SMTP_PORT=587 SMTP_TLS=starttls
#     SMTP_USERNAME=<login> SMTP_PASSWORD=<smtp key>
#   Implicit TLS instead: SMTP_PORT=465 SMTP_TLS=implicit
#SMTP_USERNAME=
#SMTP_PASSWORD=
#SMTP_TIMEOUT=30s

# --- SMS (internal/platform/sms) ---
# Phone-number verification codes. With any of these unset, SMS bodies are
# written to the API log instead (development).
#TWILIO_ACCOUNT_SID=
#TWILIO_AUTH_TOKEN=
#TWILIO_FROM=+15550001111

# AI analyst (internal/ai). Leave ANTHROPIC_API_KEY empty to turn it off.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
# Model tokens per organization per UTC day (0 = no cap).
AI_DAILY_TOKEN_LIMIT=2000000
