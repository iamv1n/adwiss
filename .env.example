# Copy to .env for local development.
APP_ENV=development
LOG_LEVEL=debug

API_ADDR=:8080
DATABASE_URL=postgres://adwise:adwise@localhost:5432/adwise?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Base URL of the web app, used to build invitation links.
WEB_BASE_URL=http://localhost:3000

SESSION_TTL=720h
# Set to true when served over HTTPS.
COOKIE_SECURE=false

# --- Provider integrations (internal/integrations) ---
# AES-256-GCM key for provider tokens: base64 of 32 random bytes, optionally
# "id:<b64>,oldid:<b64>" to rotate (first key encrypts, all decrypt).
# Generate a real one with: openssl rand -base64 32
# The value below is a PUBLIC development key; it is refused outside development.
TOKEN_ENCRYPTION_KEY=dev1:ZGV2LW9ubHktYWR3aXNlLXRva2VuLWtleS0zMmJ5dGU=
# Browser-facing API base used for OAuth redirect URIs
# ({API_BASE_URL}/v1/integrations/{meta|google}/callback). Defaults to
# ${WEB_BASE_URL}/api, i.e. through the Next.js proxy.
API_BASE_URL=http://localhost:3000/api

# Meta app (developers.facebook.com). Leave empty to disable Meta (503 provider_not_configured).
META_APP_ID=
META_APP_SECRET=
#META_API_VERSION=v26.0
#META_CONVERSION_ACTION_TYPE=purchase

# Google Cloud OAuth client (web application) + Google Ads developer token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DEVELOPER_TOKEN=
# Optional default manager (MCC) account used as login-customer-id.
#GOOGLE_LOGIN_CUSTOMER_ID=
#GOOGLE_ADS_API_VERSION=v25
